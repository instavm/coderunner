{
  "manifest_version": 3,
  "name": "CodeRunner",
  "version": "1.0.3",
  "description": "Lets your local CodeRunner assistant use the tabs in its CodeRunner tab group, and no other tab.",
  "key": "",
  "minimum_chrome_version": "125",
  "permissions": ["alarms", "debugger", "nativeMessaging", "tabGroups", "tabs"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "CodeRunner: not connected"}
}
